{
  "action": {
    "default_popup": "popup.html",
    "default_title": "Free Wall"
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "自用免费版：扫描 X 已认证粉丝回关、扫描正在关注列表取关未回关/无蓝V账号。无授权校验、无后端、数据只存本地。",
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "Free Wall - X 回关/取关助手（自用免费版）",
  "permissions": [
    "storage"
  ],
  "version": "1.0.4"
}